diff --git a/firmware/fw_base.S b/firmware/fw_base.S
index bce9e226..2934ebd7 100644
--- a/firmware/fw_base.S
+++ b/firmware/fw_base.S
@@ -234,6 +234,9 @@ _scratch_init:
 	/* Store hartid-to-scratch function address in scratch space */
 	lla	a4, _hartid_to_scratch
 	REG_S	a4, SBI_SCRATCH_HARTID_TO_SCRATCH_OFFSET(tp)
+	/* Store trap-exit function address in scratch space */
+	lla	a4, _trap_exit
+	REG_S	a4, SBI_SCRATCH_TRAP_EXIT_OFFSET(tp)
 	/* Clear trap_context and tmp0 in scratch space */
 	REG_S	zero, SBI_SCRATCH_TRAP_CONTEXT_OFFSET(tp)
 	REG_S	zero, SBI_SCRATCH_TMP0_OFFSET(tp)
@@ -372,6 +375,10 @@ _start_warm:
 	srli	a5, a5, ('H' - 'A')
 	andi	a5, a5, 0x1
 	beq	a5, zero, _skip_trap_handler_hyp
+	/* Override trap exit for H-extension */
+	csrr	a5, CSR_MSCRATCH
+	lla	a4, _trap_exit_rv32_hyp
+	REG_S	a4, SBI_SCRATCH_TRAP_EXIT_OFFSET(a5)
 	lla	a4, _trap_handler_hyp
 _skip_trap_handler_hyp:
 	csrw	CSR_MTVEC, a4
@@ -646,6 +653,7 @@ memcmp:
 	.section .entry, "ax", %progbits
 	.align 3
 	.globl _trap_handler
+	.globl _trap_exit
 _trap_handler:
 	TRAP_SAVE_AND_SETUP_SP_T0
 
@@ -657,6 +665,7 @@ _trap_handler:
 
 	TRAP_CALL_C_ROUTINE
 
+_trap_exit:
 	TRAP_RESTORE_GENERAL_REGS_EXCEPT_A0_T0
 
 	TRAP_RESTORE_MEPC_MSTATUS 0
@@ -668,6 +677,7 @@ _trap_handler:
 	.section .entry, "ax", %progbits
 	.align 3
 	.globl _trap_handler_hyp
+	.globl _trap_exit_rv32_hyp
 _trap_handler_hyp:
 	TRAP_SAVE_AND_SETUP_SP_T0
 
@@ -687,6 +697,7 @@ _trap_handler_hyp:
 
 	TRAP_CALL_C_ROUTINE
 
+_trap_exit_rv32_hyp:
 	TRAP_RESTORE_GENERAL_REGS_EXCEPT_A0_T0
 
 #if __riscv_xlen == 32
