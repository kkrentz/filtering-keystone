 /** Maximum size of sbi_scratch (4KB) */
 #define SBI_SCRATCH_SIZE			(0x1000)
 
@@ -81,6 +83,8 @@ struct sbi_scratch {
 	unsigned long hartid_to_scratch;
 	/** Address of current trap context */
